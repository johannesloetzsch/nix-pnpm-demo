{
  "name": "nix-pnpm-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter nix-pnpm-demo-vite dev",
    "build": "turbo run build",
    "typecheck": "pnpm --filter nix-pnpm-demo-vite exec tsc -b --noEmit && pnpm --filter nix-pnpm-demo-e2e exec tsc -b --noEmit",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter nix-pnpm-demo-e2e test",
    "test:e2e:ui": "pnpm --filter nix-pnpm-demo-e2e exec playwright test --ui",
    "test:e2e:report": "pnpm --filter nix-pnpm-demo-e2e exec playwright show-report",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.11.7"
  },

  "packageManager": "pnpm@10.28.0"
}
